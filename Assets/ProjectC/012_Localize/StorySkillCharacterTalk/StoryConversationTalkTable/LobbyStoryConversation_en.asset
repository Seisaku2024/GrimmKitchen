  m_Name: LobbyStoryConversation_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: d8b08f6ec4e297e45914136a6b821843, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 14621912887296
    m_Localized: Charlotte
    m_Metadata:
      m_Items: []
  - m_Id: 2550173298688
    m_Localized: Sigh... Another slow day at the restaurant.
    m_Metadata:
      m_Items: []
  - m_Id: 2550215241728
    m_Localized: '(Ever since Grandma Anna suddenly disappeared,

      I''ve been
      doing my best to run the place...

      but man, this is harder than I thought.)'
    m_Metadata:
      m_Items: []
  - m_Id: 2550215241729
    m_Localized: "(I just can't seem to recreate her flavors.\nI\u2019m following
      the recipes exactly like she taught me when I was little,\nbut something\u2019s
      just... off.)"
    m_Metadata:
      m_Items: []
  - m_Id: 2550215241730
    m_Localized: "(Alright, maybe I need to go back to basics and find her old recipes!\nThere
      might be a step I don\u2019t know about...\nI'll search every corner of this
      room!)"
    m_Metadata:
      m_Items: []
  - m_Id: 75972404342784
    m_Localized: (...Huh?)
    m_Metadata:
      m_Items: []
  - m_Id: 75972404342785
    m_Localized: "(Wait, isn\u2019t this the storybook Grandma used to read to me?)"
    m_Metadata:
      m_Items: []
  - m_Id: 75972404342786
    m_Localized: '(Wow... this takes me back.

      She always brought different
      books whenever we met.)'
    m_Metadata:
      m_Items: []
  - m_Id: 75972404342787
    m_Localized: "(This one... Hansel and Gretel?\nI loved this story\u2014I made
      her read it to me so many times!)"
    m_Metadata:
      m_Items: []
  - m_Id: 75972404342788
    m_Localized: "(...Wait. Is this book... glowing...?\nAh\u2014it's so bright!)"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
