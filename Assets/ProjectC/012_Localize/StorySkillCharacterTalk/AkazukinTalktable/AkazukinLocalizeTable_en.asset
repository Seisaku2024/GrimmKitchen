  m_TableData:
  - m_Id: 2640761876480
    m_Localized: Hello, Chef! My name is Little Red Riding Hood. I'm on my way to
      visit my grandmother!
    m_Metadata:
      m_Items: []
  - m_Id: 2640795430912
    m_Localized: "Wow! What? You\u2019ve recently opened a new restaurant? That\u2019s
      amazing!"
    m_Metadata:
      m_Items: []
  - m_Id: 2640795430913
    m_Localized: "Wow, I\u2019d love to work at a restaurant like that! Maybe I\u2019ll
      stop by and visit sometime!"
    m_Metadata:
      m_Items: []
  - m_Id: 2640795430914
    m_Localized: "Huh? Watch out for wolves, you say? Thanks! But don\u2019t worry!
      The hunter\u2019s been teaching me how to use a gun, so I\u2019m not afraid
      of any wolves!"
    m_Metadata:
      m_Items: []
  - m_Id: 2640799625216
    m_Localized: "Oh, that\u2019s right! If you ever need help, just call me! I\u2019ll
      come running right away!"
    m_Metadata:
      m_Items: []
  - m_Id: 2640799625217
    m_Localized: I should get going to Grandma's now... See you later!
    m_Metadata:
      m_Items: []
  - m_Id: 710335349420032
    m_Localized: Little Red Riding Hood
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
