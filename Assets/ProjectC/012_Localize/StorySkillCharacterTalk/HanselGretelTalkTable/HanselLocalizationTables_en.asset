  m_TableData:
  - m_Id: 2056012984320
    m_Localized: Hello, I'm Hansel, and this is Gretel. Thank you for saving us from
      danger.
    m_Metadata:
      m_Items: []
  - m_Id: 2056054927360
    m_Localized: "You're a chef, right? That's pretty unique! ...Wow, you already
      have your own restaurant? That\u2019s amazing!"
    m_Metadata:
      m_Items: []
  - m_Id: 2056054927361
    m_Localized: "I\u2019d love to visit sometime! I\u2019ll see you then!"
    m_Metadata:
      m_Items: []
  - m_Id: 2056054927362
    m_Localized: Well, I should be heading back now. See you later!
    m_Metadata:
      m_Items: []
  - m_Id: 642097324257280
    m_Localized: Hansel
    m_Metadata:
      m_Items: []
