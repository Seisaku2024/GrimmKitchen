MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: GretelStoryLocallizationTable_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: d559fd8e305eaa641a9c1e5be5b0a616, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 7630226223104
    m_Localized: "Huh? Someone I\u2019ve never met before!\nI\u2019m Gretel! What\u2019s
      your name?"
    m_Metadata:
      m_Items: []
  - m_Id: 7630268166144
    m_Localized: Charlotte! Nice to meet you, Charlotte!
    m_Metadata:
      m_Items: []
  - m_Id: 4517901758734336
    m_Localized: 'Did you come from the ''outside world,'' Charlotte?

      You
      look just like the grandma who used to play with us,

      so I thought maybe
      you came from outside, just like her!'
    m_Metadata:
      m_Items: []
  - m_Id: 7630268166146
    m_Localized: "Oh no\u2026 You ended up here all of a sudden and don\u2019t know
      what to do, right?\nIf you want to go back to the 'outside world,' I can help!\nThere\u2019s
      a way back near our house that Grandma used to use!"
    m_Metadata:
      m_Items: []
  - m_Id: 4517901796483072
    m_Localized: "I\u2019ll take you there!\nIf we follow the breadcrumb trail that
      Hansel left,\nwe won\u2019t get lost, so don\u2019t worry!"
    m_Metadata:
      m_Items: []
  - m_Id: 2853908748464128
    m_Localized: 'Oh no!!

      The chickens are eating the breadcrumbs!'
    m_Metadata:
      m_Items: []
  - m_Id: 2853908777824256
    m_Localized: "If this keeps up, we won\u2019t be able to get home\u2026\nHuh?
      You\u2019re going to help, Charlotte?"
    m_Metadata:
      m_Items: []
  - m_Id: 2853908777824257
    m_Localized: "Thank you!\nPlease protect Hansel\u2019s trail!"
    m_Metadata:
      m_Items: []
  - m_Id: 3082225921585152
    m_Localized: "Charlotte, thank you for helping me!\nThanks to you, I won\u2019t
      get lost on the way home!"
    m_Metadata:
      m_Items: []
  - m_Id: 3082225946750976
    m_Localized: "I feel a little bad for the chickens...\nBut we had to do it to
      find our way back...\nAt the very least, we shouldn\u2019t let them go to waste."
    m_Metadata:
      m_Items: []
  - m_Id: 3082225946750977
    m_Localized: 'Oh! Grandma used to bring food back from the forest too.

      She
      was really good at gathering all kinds of ingredients!'
    m_Metadata:
      m_Items: []
  - m_Id: 3082225946750978
    m_Localized: "Charlotte, why don\u2019t you try gathering food too?\nThere are
      lots of tasty nuts and mushrooms along the way home, so let\u2019s keep an
      eye out!"
    m_Metadata:
      m_Items: []
  - m_Id: 3304781010202624
    m_Localized: "Look, look!\nThat pot was used by Grandma!\nIt\u2019s been around
      since when she was young!"
    m_Metadata:
      m_Items: []
  - m_Id: 3304781039562752
    m_Localized: "Grandma\u2019s cooking was soooo delicious!\nIt\u2019s like magic
      \u2013 eating it can even heal wounds!"
    m_Metadata:
      m_Items: []
  - m_Id: 3304781043757056
    m_Localized: "Oh, and she used to make this weird dish that made you feel all
      tingly.\nShe\u2019d carry it around without eating it though\u2026 I wonder
      what it was for?\nDo you want to try making something too, Charlotte?"
    m_Metadata:
      m_Items: []
  - m_Id: 3674760184360960
    m_Localized: "Aaaahhhhhhh!!!\nStop, don\u2019t eat the house!\nGo away!"
    m_Metadata:
      m_Items: []
  - m_Id: 3674760184360961
    m_Localized: "That\u2019s Hansel\u2019s voice!\nI can hear it from the end of
      the breadcrumb trail!"
    m_Metadata:
      m_Items: []
  - m_Id: 3704603655565312
    m_Localized: "I\u2019ve never heard him scream like that before\u2026\nWe have
      to hurry!"
    m_Metadata:
      m_Items: []
  - m_Id: 3741059996479488
    m_Localized: Ouch...
    m_Metadata:
      m_Items: []
  - m_Id: 3741059996479489
    m_Localized: 'Big brother! What happened!?

      You''re hurt... are you okay?'
    m_Metadata:
      m_Items: []
  - m_Id: 3741059996479490
    m_Localized: "Ah, Gretel!\nI'm glad you're safe. This is nothing, don\u2019t
      worry."
    m_Metadata:
      m_Items: []
  - m_Id: 3741059996479491
    m_Localized: "Who\u2019s the lady with you?\nIs she your friend?"
    m_Metadata:
      m_Items: []
  - m_Id: 3741059996479492
    m_Localized: "This is Charlotte! I met her at the edge of the forest just now!\nShe\u2019s
      from the outside world, just like Grandma.\nShe\u2019s really good at hunting,
      just like Grandma!"
    m_Metadata:
      m_Items: []
  - m_Id: 3741059996479493
    m_Localized: "Just like Aunt Anna...\nNo wonder I felt like I\u2019ve seen her
      somewhere before."
    m_Metadata:
      m_Items: []
  - m_Id: 3741059996479494
    m_Localized: 'Nice to meet you, Charlotte.

      I''m Hansel, and Gretel has
      been in your care.'
    m_Metadata:
      m_Items: []
  - m_Id: 3741059996479495
    m_Localized: "If it\u2019s possible, could you help us?\nA huge chicken suddenly
      showed up and is trying to eat our candy house!"
    m_Metadata:
      m_Items: []
  - m_Id: 3741059996479496
    m_Localized: "This house is a very important place where my sister and I live
      with the candy witch.\nWe have to protect it until the witch returns...\nI
      couldn\u2019t do anything on my own..."
    m_Metadata:
      m_Items: []
  - m_Id: 4517901796483073
    m_Localized: "If you\u2019re as good at hunting as Aunt Anna,\nmaybe you can
      handle that chicken.\nPlease, protect this house."
    m_Metadata:
      m_Items: []
  - m_Id: 4517901796483074
    m_Localized: "Charlotte, I\u2019m asking you too!\nPlease protect the candy house!"
    m_Metadata:
      m_Items: []
  - m_Id: 4517901796483075
    m_Localized: "...Thank you! You\u2019ll help us a lot.\nWe\u2019ll help too.
      Call us if you need strength.\nEven if we can\u2019t finish it off, we\u2019ll
      be of use!"
    m_Metadata:
      m_Items: []
  - m_Id: 3801962351718400
    m_Localized: 'Thank you, Charlotte!

      You saved us. Now the candy house
      is safe.'
    m_Metadata:
      m_Items: []
  - m_Id: 3801962381078528
    m_Localized: "\u2026You want ingredients from this world?\nOf course, take whatever
      you like.\nLately, animals have been increasing, so we\u2019ve been having
      trouble ourselves."
    m_Metadata:
      m_Items: []
  - m_Id: 3801962381078529
    m_Localized: "I see, you took over Aunt Anna\u2019s restaurant.\nIf you use the
      ingredients here, maybe you can recreate Aunt Anna\u2019s flavors."
    m_Metadata:
      m_Items: []
  - m_Id: 3801962381078530
    m_Localized: "Does that mean we can eat Grandma\u2019s cooking again?\nI want
      you to make food for us too!"
    m_Metadata:
      m_Items: []
  - m_Id: 3801962381078531
    m_Localized: "Hey, Gretel.\nDon\u2019t be selfish and cause trouble."
    m_Metadata:
      m_Items: []
  - m_Id: 3801962381078532
    m_Localized: "But!\nDon\u2019t you want to eat Grandma\u2019s cooking again,
      big brother!?"
    m_Metadata:
      m_Items: []
  - m_Id: 3801962381078533
    m_Localized: "\u2026\u2026\u2026\u2026I do want to eat it."
    m_Metadata:
      m_Items: []
  - m_Id: 3801962381078534
    m_Localized: "See? Big brother wants to eat it too!\nI\u2019ll help with hunting
      anytime! Please!"
    m_Metadata:
      m_Items: []
  - m_Id: 3801962381078535
    m_Localized: "\u2026Really? Yay!\nI\u2019ll visit your shop too!"
    m_Metadata:
      m_Items: []
  - m_Id: 4517901796483076
    m_Localized: "Oh, that\u2019s right, the way home!\nThe path Grandma always used
      to go home is next to the candy house.\nIf you jump into that light, you can
      go back."
    m_Metadata:
      m_Items: []
  - m_Id: 4517901796483077
    m_Localized: "You really helped us today.\nCome visit anytime,\nwe\u2019ll be
      happy to have you, Charlotte!"
    m_Metadata:
      m_Items: []
  - m_Id: 4517901796483078
    m_Localized: "See you! Big sister!\nWhen Grandma the witch is back, let\u2019s
      all have a tea party!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
