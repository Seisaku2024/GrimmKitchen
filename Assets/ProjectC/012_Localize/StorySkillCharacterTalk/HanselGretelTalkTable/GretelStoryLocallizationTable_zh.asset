    m_Localized: "\u770B\uFF01\u770B\uFF01\n\u90A3\u4E2A\u9505\u662F\u5976\u5976\u7528\u8FC7\u7684\u54E6\uFF01\n\u4ECE\u5976\u5976\u5E74\u8F7B\u7684\u65F6\u5019\u5C31\u4E00\u76F4\u5728\u7528\u4E86\uFF01"
