  m_TableData:
  - m_Id: 60185903104
    m_Localized: "Rush to the trending restaurant!\r"
    m_Metadata:
      m_Items: []
  - m_Id: 442005979136
    m_Localized: 'It seems that a famous food magazine reporter is coming for an
      interview!

      Impress them with delicious dishes and raise the restaurant''s
      rating!'
    m_Metadata:
      m_Items: []
  - m_Id: 613196496896
    m_Localized: "Curry Starts with Spices\r"
    m_Metadata:
      m_Items: []
  - m_Id: 717924073472
    m_Localized: 'A special curry made with carefully selected spices,

      passed
      down through generations.

      Looks like my brother is ready to share the
      recipe!'
    m_Metadata:
      m_Items: []
  - m_Id: 902901268480
    m_Localized: "The Golden Ratio of Potato Salad\r"
    m_Metadata:
      m_Items: []
  - m_Id: 1014838853632
    m_Localized: 'The secret to a perfect potato salad lies in the right ingredient
      balance!

      A skilled cook is ready to share her best recipe.'
    m_Metadata:
      m_Items: []
  - m_Id: 1153410269184
    m_Localized: "Returning the Picture Book\r"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806005248
    m_Localized: "Someone is returning the picture book they borrowed from Grandma
      Anna.\nLet\u2019s serve them an extra delicious meal as thanks!"
    m_Metadata:
      m_Items: []
  - m_Id: 7348068665835520
    m_Localized: 'The food here is delicious!''

      The people of the town have
      supported the restaurant and delivered ingredients.

      Let''s repay their
      kindness with delicious dishes!'
    m_Metadata:
      m_Items: []
  - m_Id: 7347883436982272
    m_Localized: "Town's Bond\r"
    m_Metadata:
      m_Items: []
  - m_Id: 1895290372096
    m_Localized: None
    m_Metadata:
      m_Items: []
  - m_Id: 2539606769664
    m_Localized: Test
    m_Metadata:
      m_Items: []
  - m_Id: 4222424449024
    m_Localized: Persistent
    m_Metadata:
      m_Items: []
  - m_Id: 4615938244608
    m_Localized: One-time
    m_Metadata:
      m_Items: []
  - m_Id: 5493818654720
    m_Localized: Would you like to set the challenge?
    m_Metadata:
      m_Items: []
  - m_Id: 7348378855587840
    m_Localized: "First Step to a Popular Restaurant\r"
    m_Metadata:
      m_Items: []
  - m_Id: 7348435784876032
    m_Localized: 'Seeing the restaurant crowded, the carpenter suggested a renovation!

      Let''s
      earn the money needed for the renovation!'
    m_Metadata:
      m_Items: []
  - m_Id: 7348779898159104
    m_Localized: "A Blissful Sip\r"
    m_Metadata:
      m_Items: []
  - m_Id: 7348924538732544
    m_Localized: 'An old man from the neighborhood claims he''s found the world''s
      best drink.

      Serve him a delicious meal and get him to share his secret!'
    m_Metadata:
      m_Items: []
  - m_Id: 7349109440430080
    m_Localized: "Shabu-Shabu Loving CEO\r"
    m_Metadata:
      m_Items: []
  - m_Id: 7349304634949632
    m_Localized: 'A CEO who loves shabu-shabu.

      To show appreciation for his
      employees,

      he''s sharing his favorite recipe!'
    m_Metadata:
      m_Items: []
