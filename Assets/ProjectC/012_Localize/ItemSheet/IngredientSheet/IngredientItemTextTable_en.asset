  m_Name: IngredientItemTextTable_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 65a8ef99128d25344a0002933d76ea62, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 280445583360
    m_Localized: "An apple that makes you drowsy almost instantly. \nIt's nearly
      impossible to distinguish it from a regular apple."
    m_Metadata:
      m_Items: []
  - m_Id: 433499930624
    m_Localized: 'A versatile egg used in many dishes.

      No chicks will hatch
      from it.'
    m_Metadata:
      m_Items: []
  - m_Id: 775935492096
    m_Localized: 'A rare egg that shines like gold.

      Only laid by the leader
      of the flock, making it highly valuable.'
    m_Metadata:
      m_Items: []
  - m_Id: 923247837184
    m_Localized: 'Sharp fangs with venomous glands.

      The tingling poison is
      strangely addictive.'
    m_Metadata:
      m_Items: []
  - m_Id: 1223304151040
    m_Localized: 'Straight from the source.

      Exceptionally fresh meat.'
    m_Metadata:
      m_Items: []
  - m_Id: 1379206430720
    m_Localized: 'Exquisite marbled steak.

      A treat for those hard-working
      days.'
    m_Metadata:
      m_Items: []
  - m_Id: 1627031076864
    m_Localized: 'Low-calorie, high-protein poultry.

      Perfect for dieting or
      muscle training.'
    m_Metadata:
      m_Items: []
  - m_Id: 1767749976064
    m_Localized: 'The bone-in meat everyone dreams of,

      with the ultimate satisfying
      bite.'
    m_Metadata:
      m_Items: []
  - m_Id: 2082796732416
    m_Localized: 'Meat with a unique smell.

      A favorite among a select group
      of enthusiasts.'
    m_Metadata:
      m_Items: []
  - m_Id: 2238560600064
    m_Localized: 'A mushroom with a fiery pattern.

      It''s as spicy as it looks,
      so be prepared when eating it.'
    m_Metadata:
      m_Items: []
  - m_Id: 2522749861888
    m_Localized: 'A mushroom with a lightning-like pattern.

      Eating it causes
      your tongue to tingle, so be cautious.'
    m_Metadata:
      m_Items: []
  - m_Id: 2680023678976
    m_Localized: 'A dangerous mushroom with poison.

      With the right preparation,
      it can be made delicious.'
    m_Metadata:
      m_Items: []
  - m_Id: 2969170608128
    m_Localized: 'A mushroom that makes you sleepy when eaten.

      Named after
      Snow White.'
    m_Metadata:
      m_Items: []
  - m_Id: 3172665655296
    m_Localized: 'Nutrients packed in each leaf.

      Even caterpillars seem to
      love it.'
    m_Metadata:
      m_Items: []
  - m_Id: 3459719626752
    m_Localized: 'Vibrant orange in color.

      Fresh, in-season carrots are delicious
      even raw.'
    m_Metadata:
      m_Items: []
  - m_Id: 3600623075328
    m_Localized: 'A versatile ingredient that complements any dish.

      I wish
      it wouldn''t make my eyes tear up when I cut it.'
    m_Metadata:
      m_Items: []
  - m_Id: 3854554628096
    m_Localized: Small and round, a versatile potato that fits perfectly in any dish.
    m_Metadata:
      m_Items: []
  - m_Id: 66796831146217472
    m_Localized: 'Mild in flavor and easy to eat.

      A versatile gift from the
      sea.'
    m_Metadata:
      m_Items: []
  - m_Id: 67157834115551232
    m_Localized: "A drop that feels like scooping up the night.\nA rich, dark flavor
      you\u2019ll crave again and again."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
