  m_SharedData: {fileID: 11400000, guid: 314b3e1cbc07406418410f905628e538, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 274053464064
    m_Localized: 'A luxurious pudding made with a whole Golden Egg.

      So smooth
      it melts in your mouth like snow.'
    m_Metadata:
      m_Items: []
  - m_Id: 1130572283904
    m_Localized: 'A roast made with the whole Delicious Meat.

      Slow-cooked
      to perfection for an even richer flavor.'
    m_Metadata:
      m_Items: []
  - m_Id: 1356225839104
    m_Localized: 'A mysterious flavor that drips from the fangs of a venomous snake.

      Its
      rich taste captivates the hearts of adults.'
    m_Metadata:
      m_Items: []
  - m_Id: 1703044448256
    m_Localized: 'The sweetness of vegetables concentrated into one cup.

      Featuring
      the sweet taste of the star ingredient, the sweet carrot.'
    m_Metadata:
      m_Items: []
  - m_Id: 1900029935616
    m_Localized: 'Crispy on the outside, soft and warm on the inside.

      Enjoy
      while hot.'
    m_Metadata:
      m_Items: []
  - m_Id: 2260148682752
    m_Localized: 'Crispy golden petals bloom.

      A special onion fry bursting
      with sweetness.'
    m_Metadata:
      m_Items: []
  - m_Id: 2443926306816
    m_Localized: 'The aroma of charcoal-grilled chicken is unbeatable!

      A freshly
      made, piping hot dish.'
    m_Metadata:
      m_Items: []
  - m_Id: 2755441459200
    m_Localized: 'Slowly smoked jerky made from mystery meat.

      The more you
      chew, the tastier it gets.'
    m_Metadata:
      m_Items: []
  - m_Id: 2932281704448
    m_Localized: "Shabu-shabu made with luxurious Premium Aged Meat.\nA winter delicacy
      you\u2019ll crave."
    m_Metadata:
      m_Items: []
  - m_Id: 3231981502464
    m_Localized: 'A freshly grilled steak made with Fresh Catch Meat.

      Smoky
      and delicious.'
    m_Metadata:
      m_Items: []
  - m_Id: 3418388955136
    m_Localized: 'A super spicy soup made with plenty of Fire Mushrooms.

      A
      favorite dish for spice lovers'
    m_Metadata:
      m_Items: []
  - m_Id: 3737550323712
    m_Localized: "A soup made by simmering Shock Mushrooms.\nIt\u2019s quite delicious,
      but with a tingling sensation."
    m_Metadata:
      m_Items: []
  - m_Id: 3919146909696
    m_Localized: 'A potage made with Witch Mushroom.

      Its appearance aside,
      it resembles a toxic soup brewed by a witch.'
    m_Metadata:
      m_Items: []
  - m_Id: 4202509893632
    m_Localized: 'A soup that induces a powerful drowsiness upon consumption.

      The
      simmering has intensified its effects.'
    m_Metadata:
      m_Items: []
  - m_Id: 4399172419584
    m_Localized: 'A beloved omelet that everyone enjoys.

      The wonderful aroma
      of eggs stirs up your appetite.'
    m_Metadata:
      m_Items: []
  - m_Id: 4681973366784
    m_Localized: 'An omelette packed with Shock Mushrooms.

      Eating it will
      leave you with a tingling sensation.'
    m_Metadata:
      m_Items: []
  - m_Id: 4855726604288
    m_Localized: 'An omelette packed with Fire Mushrooms.

      It''s so spicy,
      it''ll make you breathe fire.'
    m_Metadata:
      m_Items: []
  - m_Id: 5212305358848
    m_Localized: 'A delicious pie with a lovely apple fragrance.

      However,
      eating it will soon make you feel drowsy.'
    m_Metadata:
      m_Items: []
  - m_Id: 5409940963328
    m_Localized: 'Crisp and refreshing!

      A healthy snack packed with the deliciousness
      of vegetables.'
    m_Metadata:
      m_Items: []
  - m_Id: 5714296438784
    m_Localized: 'A salad with a perfect balance of sweetness and tartness, and a
      vibrant appearance.

      The texture of the apple adds a delightful accent.'
    m_Metadata:
      m_Items: []
  - m_Id: 5913723011072
    m_Localized: "No matter the ingredients from another world,\nit\u2019s always
      the same\u2014full of love, with generous chunks of meat and vegetables in
      a luxurious dish."
    m_Metadata:
      m_Items: []
  - m_Id: 6169160318976
    m_Localized: 'A dish that calls for you on chilly days.

      A gentle taste
      where the flavors of various ingredients blend together, offering warmth.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
