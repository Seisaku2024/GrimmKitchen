  m_Name: 
  m_EditorClassIdentifier: 
  m_TrackedObjects:
  - rid: 9014588110139293713
  references:
    version: 2
    RefIds:
    - rid: 9014588110139293713
      type: {class: TrackedMonoBehaviourObject, ns: UnityEngine.Localization.PropertyVariants.TrackedObjects, asm: Unity.Localization}
      data:
        m_Target: {fileID: 7708664456243240112}
        m_TrackedProperties:
          items:
          - rid: 9014588110139293714
          - rid: 9014588110139293715
        m_UpdateType: 1
        m_Changed:
          m_PersistentCalls:
            m_Calls: []
    - rid: 9014588110139293714
      type: {class: StringTrackedProperty, ns: UnityEngine.Localization.PropertyVariants.TrackedProperties, asm: Unity.Localization}
      data:
        m_PropertyPath: m_tutorialDataList.Array.data[0].m_text
        m_VariantData:
        - localeIdentifier:
            m_Code: ja
          value: "\u7D4C\u55B6\u30D1\u30FC\u30C8\u3067\u306F\u3001\u9078\u3093\u3060\u6599\u7406\u3092\u5236\u9650\u6642\u9593\u5185\u306B\r\n\u3067\u304D\u308B\u3060\u3051\u591A\u304F\u63D0\u4F9B\u3057\u3001\u304A\u91D1\u3092\u7A3C\u304E\u307E\u3059\u3002"
        - localeIdentifier:
            m_Code: en
          value: 'In the management phase,

            serve as many dishes as
            possible within the time limit to earn money.'
        - localeIdentifier:
            m_Code: zh
          value: "\u5728\u7ECF\u8425\u9636\u6BB5\uFF0C\n\u9700\u5728\u9650\u65F6\u5185\u5C3D\u53EF\u80FD\u591A\u5730\u63D0\u4F9B\u6599\u7406\u6765\u8D5A\u94B1\u3002"
    - rid: 9014588110139293715
      type: {class: StringTrackedProperty, ns: UnityEngine.Localization.PropertyVariants.TrackedProperties, asm: Unity.Localization}
      data:
        m_PropertyPath: m_tutorialDataList.Array.data[1].m_text
        m_VariantData:
        - localeIdentifier:
            m_Code: ja
          value: "\u6E05\u6383\u3084\u98DF\u3044\u9003\u3052\u306A\u3069\u3001\u3055\u307E\u3056\u307E\u306A\u30A4\u30D9\u30F3\u30C8\u304C\u767A\u751F\u3057\u307E\u3059\u3002\r\n\u5BFE\u5FDC\u6B21\u7B2C\u3067\u3001\u3055\u3089\u306B\u591A\u304F\u306E\u304A\u91D1\u3092\u7A3C\u3052\u308B\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3002"
        - localeIdentifier:
            m_Code: en
          value: 'Various events such as cleaning and dine-and-dash incidents will
            occur.

            How you handle them may help you earn even more money!'
        - localeIdentifier:
            m_Code: zh
          value: "\u6E05\u626B\u3001\u9003\u5355\u7B49\u5404\u79CD\u4E8B\u4EF6\u4F1A\u53D1\u751F\u3002\n\u4F60\u7684\u5E94\u5BF9\u65B9\u5F0F\u53EF\u80FD\u4F1A\u8BA9\u4F60\u8D5A\u5230\u66F4\u591A\u94B1\uFF01"
