--- !u!114 &7708664456243240112
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6931952759738522643}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: be8825ea3caf5c34f9b5f76ebacfa1c4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_tutorialDataList:
  - m_sprite: {fileID: 21300000, guid: 3d83d0a7c264c504d913b0fdc4574552, type: 3}
    m_inputActionReference: {fileID: 0}
    m_inputActionText: 
    m_text: "\u7D4C\u55B6\u30D1\u30FC\u30C8\u3067\u306F\u3001\u9078\u3093\u3060\u6599\u7406\u3092\u5236\u9650\u6642\u9593\u5185\u306B\r\n\u3067\u304D\u308B\u3060\u3051\u591A\u304F\u63D0\u4F9B\u3057\u3001\u304A\u91D1\u3092\u7A3C\u304E\u307E\u3059\u3002"
  - m_sprite: {fileID: 21300000, guid: 3d83d0a7c264c504d913b0fdc4574552, type: 3}
    m_inputActionReference: {fileID: 0}
    m_inputActionText: 
    m_text: "\u6E05\u6383\u3084\u98DF\u3044\u9003\u3052\u306A\u3069\u3001\u3055\u307E\u3056\u307E\u306A\u30A4\u30D9\u30F3\u30C8\u304C\u767A\u751F\u3057\u307E\u3059\u3002\r\n\u5BFE\u5FDC\u6B21\u7B2C\u3067\u3001\u3055\u3089\u306B\u591A\u304F\u306E\u304A\u91D1\u3092\u7A3C\u3052\u308B\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3002"
  m_nextInputActionButton: {fileID: 716470872526815635}
  m_backInputActionButton: {fileID: 6819775822939186732}
  m_closeInputActionButton: {fileID: 1914688661883183108}
--- !u!114 &2615966416399035750
MonoBehaviour:
  m_ObjectHideFlags: 0
