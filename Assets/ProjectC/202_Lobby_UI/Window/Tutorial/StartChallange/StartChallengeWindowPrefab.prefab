  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 69beb381e244f92449b8c4cf954630e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_TrackedObjects:
  - rid: 9014588121086689280
  references:
    version: 2
    RefIds:
    - rid: 9014588121086689280
      type: {class: TrackedMonoBehaviourObject, ns: UnityEngine.Localization.PropertyVariants.TrackedObjects, asm: Unity.Localization}
      data:
        m_Target: {fileID: 7708664456243240112}
        m_TrackedProperties:
          items:
          - rid: 9014588121086689281
          - rid: 9014588121086689282
        m_UpdateType: 1
        m_Changed:
          m_PersistentCalls:
            m_Calls: []
    - rid: 9014588121086689281
      type: {class: StringTrackedProperty, ns: UnityEngine.Localization.PropertyVariants.TrackedProperties, asm: Unity.Localization}
      data:
        m_PropertyPath: m_tutorialDataList.Array.data[0].m_text
        m_VariantData:
        - localeIdentifier:
            m_Code: ja
          value: "\u300C\u30C1\u30E3\u30EC\u30F3\u30B8\u300D\u304C\u89E3\u7981\u3055\u308C\u307E\u3057\u305F\u3002\n\u30C1\u30E3\u30EC\u30F3\u30B8\u3092\u30BB\u30C3\u30C8\u3057\u3066\u6761\u4EF6\u3092\u9054\u6210\u3059\u308B\u3053\u3068\u3067\n\u5831\u916C\u304C\u624B\u306B\u5165\u308A\u307E\u3059\uFF01"
        - localeIdentifier:
            m_Code: en
          value: '"Challenges" have been unlocked!

            Set a challenge and
            complete the conditions to earn rewards!'
        - localeIdentifier:
            m_Code: zh
          value: "\u300C\u6311\u6218\u300D\u5DF2\u89E3\u9501\uFF01\n\u8BBE\u7F6E\u6311\u6218\u5E76\u8FBE\u6210\u6761\u4EF6\u5373\u53EF\u83B7\u5F97\u5956\u52B1\uFF01"
    - rid: 9014588121086689282
      type: {class: StringTrackedProperty, ns: UnityEngine.Localization.PropertyVariants.TrackedProperties, asm: Unity.Localization}
      data:
        m_PropertyPath: m_tutorialDataList.Array.data[1].m_text
        m_VariantData:
        - localeIdentifier:
            m_Code: ja
          value: "\u5148\u305A\u306F\u300C\u7D75\u672C\u3092\u8FD4\u3057\u306B\u6765\u305F\u3088\u300D\u306E\n\u30C1\u30E3\u30EC\u30F3\u30B8\u306B\u6311\u6226\u3057\u3066\u307F\u307E\u3057\u3087\u3046\u3002\n\u9054\u6210\u6761\u4EF6\u306E\u78BA\u8A8D\u3082\u5FD8\u308C\u305A\u306B\uFF01"
        - localeIdentifier:
            m_Code: en
          value: 'Let''s start with the "Returning the Picture Book" challenge.

            Don''t
            forget to check the completion requirements!'
        - localeIdentifier:
            m_Code: zh
          value: "\u9996\u5148\u5C1D\u8BD5\u300C\u6765\u5F52\u8FD8\u7ED8\u672C\u5566\u300D\u6311\u6218\u5427\u3002\n\u522B\u5FD8\u4E86\u786E\u8BA4\u8FBE\u6210\u6761\u4EF6\uFF01"
