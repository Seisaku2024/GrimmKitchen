--- !u!114 &7708664456243240112
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6931952759738522643}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: be8825ea3caf5c34f9b5f76ebacfa1c4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_tutorialDataList:
  - m_sprite: {fileID: 21300000, guid: d30d3e3c03eae264b8bdd6c407c041e6, type: 3}
    m_inputActionReference: {fileID: 0}
    m_inputActionText: 
    m_text: "\u300C\u30C1\u30E3\u30EC\u30F3\u30B8\u300D\u304C\u89E3\u7981\u3055\u308C\u307E\u3057\u305F\u3002\n\u30C1\u30E3\u30EC\u30F3\u30B8\u3092\u30BB\u30C3\u30C8\u3057\u3066\u6761\u4EF6\u3092\u9054\u6210\u3059\u308B\u3053\u3068\u3067\n\u5831\u916C\u304C\u624B\u306B\u5165\u308A\u307E\u3059\uFF01"
  - m_sprite: {fileID: 21300000, guid: 13c21955331352b498642f5f15048163, type: 3}
    m_inputActionReference: {fileID: 0}
    m_inputActionText: 
    m_text: "\u5148\u305A\u306F\u300C\u7D75\u672C\u3092\u8FD4\u3057\u306B\u6765\u305F\u3088\u300D\u306E\n\u30C1\u30E3\u30EC\u30F3\u30B8\u306B\u6311\u6226\u3057\u3066\u307F\u307E\u3057\u3087\u3046\u3002\n\u9054\u6210\u6761\u4EF6\u306E\u78BA\u8A8D\u3082\u5FD8\u308C\u305A\u306B\uFF01"
  m_nextInputActionButton: {fileID: 716470872526815635}
  m_backInputActionButton: {fileID: 6819775822939186732}
  m_closeInputActionButton: {fileID: 1914688661883183108}
--- !u!114 &3836430630536032204
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6931952759738522643}
