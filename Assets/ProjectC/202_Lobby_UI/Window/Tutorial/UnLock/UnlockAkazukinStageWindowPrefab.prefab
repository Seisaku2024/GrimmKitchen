        m_VariantData:
        - localeIdentifier:
            m_Code: ja
          value: "\u30C1\u30E3\u30EC\u30F3\u30B8\u3092\u9054\u6210\u3057\u305F\u3053\u3068\u3067\n\u65B0\u3057\u3044\u30B9\u30C6\u30FC\u30B8\u300C\u8D64\u305A\u304D\u3093\u306E\u68EE\u300D\u304C\u89E3\u653E\u3055\u308C\u307E\u3057\u305F\u3002\n\u65B0\u3057\u3044\u98DF\u6750\u3001\u307E\u3060\u898B\u306C\u5F37\u6575\u306B\u4F1A\u3044\u306B\u884C\u304D\u307E\u3057\u3087\u3046\uFF01"
        - localeIdentifier:
            m_Code: en
          value: "By completing the challenge,\n you've unlocked a new stage: \n'Red
            Riding Hood's Forest'!\nDiscover new ingredients and face formidable
            foes awaiting you!"
        - localeIdentifier:
            m_Code: zh
          value: "\u901A\u8FC7\u5B8C\u6210\u6311\u6218\uFF0C\n\u4F60\u89E3\u9501\u4E86\u65B0\u9636\u6BB5\uFF1A\u2018\u5C0F\u7EA2\u5E3D\u68EE\u6797\u2019\uFF01\n\u53BB\u53D1\u73B0\u65B0\u7684\u98DF\u6750\uFF0C\u5E76\u8FCE\u6218\u5F3A\u5927\u7684\u654C\u4EBA\u5427\uFF01"
