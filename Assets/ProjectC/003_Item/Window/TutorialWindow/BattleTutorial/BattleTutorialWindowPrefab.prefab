  m_Name: 
  m_EditorClassIdentifier: 
  m_tutorialDataList:
  - m_sprite: {fileID: 21300000, guid: 971513ab7c941e840b3d78d9209d238b, type: 3}
    m_inputActionReference: {fileID: 2556082560264285908, guid: ddf85ec2b76f22d49a20cae2e727e7f0, type: 3}
    m_inputActionText: "\u653B\u6483"
    m_text: "\u9023\u6253\u3067\u6700\u59275\u56DE\u653B\u6483\u3002\r\n\u30C0\u30C3\u30B7\u30E5\u4E2D\u306B\u62BC\u3059\u3068\u30C0\u30C3\u30B7\u30E5\u653B\u6483\u3082\u3067\u304D\u308B\u3002"
  - m_sprite: {fileID: 21300000, guid: 621497c08ff14714797b95341e65d080, type: 3}
    m_inputActionReference: {fileID: -809664392839982606, guid: ddf85ec2b76f22d49a20cae2e727e7f0, type: 3}
    m_inputActionText: "\u56DE\u907F"
    m_text: "\u6575\u306E\u653B\u6483\u306B\u5408\u308F\u305B\u3066\u30DC\u30BF\u30F3\u3092\u62BC\u3059\u3068\u56DE\u907F\u3067\u304D\u307E\u3059\u3002\n\u56DE\u907F\u306B\u306F\u30B9\u30BF\u30DF\u30CA\u3092\u6D88\u8CBB\u3057\u3001\u30B9\u30BF\u30DF\u30CA\u304C\u306A\u3044\u3068\u56DE\u907F\u3067\u304D\u307E\u305B\u3093\u3002"
  m_nextInputActionButton: {fileID: 716470872526815635}
  m_backInputActionButton: {fileID: 6819775822939186732}
  m_closeInputActionButton: {fileID: 1914688661883183108}
