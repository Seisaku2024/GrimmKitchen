            m_Code: ja
          value: "\u653B\u6483"
        - localeIdentifier:
            m_Code: en
          value: Attack
        - localeIdentifier:
            m_Code: zh
          value: "\u653B\u51FB"
    - rid: 9014588065020379221
      type: {class: StringTrackedProperty, ns: UnityEngine.Localization.PropertyVariants.TrackedProperties, asm: Unity.Localization}
      data:
        m_PropertyPath: m_tutorialDataList.Array.data[0].m_text
        m_VariantData:
        - localeIdentifier:
            m_Code: ja
          value: "\u9023\u6253\u3067\u6700\u59275\u56DE\u653B\u6483\u3002\r\n\u30C0\u30C3\u30B7\u30E5\u4E2D\u306B\u62BC\u3059\u3068\u30C0\u30C3\u30B7\u30E5\u653B\u6483\u3082\u3067\u304D\u308B\u3002"
        - localeIdentifier:
            m_Code: en
          value: 'Press repeatedly for up to 5 hits.

            Press during a
            dash for a dash attack.'
        - localeIdentifier:
            m_Code: zh
          value: "\u8FDE\u7EED\u6309\u538B\u6700\u591A5\u6B21\u653B\u51FB\u3002\r\n\u51B2\u523A\u65F6\u6309\u538B\u8FDB\u884C\u51B2\u523A\u653B\u51FB\u3002\r"
    - rid: 9014588065020379222
      type: {class: StringTrackedProperty, ns: UnityEngine.Localization.PropertyVariants.TrackedProperties, asm: Unity.Localization}
      data:
        m_PropertyPath: m_tutorialDataList.Array.data[1].m_inputActionText
        m_VariantData:
        - localeIdentifier:
            m_Code: ja
          value: "\u56DE\u907F"
        - localeIdentifier:
            m_Code: en
          value: Dodge
        - localeIdentifier:
            m_Code: zh
          value: "\u95EA\u907F"
    - rid: 9014588065020379223
      type: {class: StringTrackedProperty, ns: UnityEngine.Localization.PropertyVariants.TrackedProperties, asm: Unity.Localization}
      data:
        m_PropertyPath: m_tutorialDataList.Array.data[1].m_text
        m_VariantData:
        - localeIdentifier:
            m_Code: ja
          value: "\u6575\u306E\u653B\u6483\u306B\u5408\u308F\u305B\u3066\u30DC\u30BF\u30F3\u3092\u62BC\u3059\u3068\u56DE\u907F\u3067\u304D\u307E\u3059\u3002\n\u56DE\u907F\u306B\u306F\u30B9\u30BF\u30DF\u30CA\u3092\u6D88\u8CBB\u3057\u3001\u30B9\u30BF\u30DF\u30CA\u304C\u306A\u3044\u3068\u56DE\u907F\u3067\u304D\u307E\u305B\u3093\u3002"
        - localeIdentifier:
            m_Code: en
          value: 'Press the button in time with enemy attacks to dodge.

            Dodge
            consumes stamina, and you can''t dodge without it.'
        - localeIdentifier:
            m_Code: zh
          value: "\u4E0E\u654C\u4EBA\u653B\u51FB\u540C\u6B65\u6309\u4E0B\u6309\u94AE\u8FDB\u884C\u95EA\u907F\u3002\n\u95EA\u907F\u6D88\u8017\u4F53\u529B\uFF0C\u4F53\u529B\u4E0D\u8DB3\u65F6\u65E0\u6CD5\u95EA\u907F\u3002"
